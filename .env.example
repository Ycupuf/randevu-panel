# Bu dosyayı .env.local olarak kopyala ve değerleri doldur. .env.local ASLA commit edilmez.
# Aynı Supabase projesini müşteri sitesiyle (randevu-web) paylaşır.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bu panelin adresi ve müşteri sitesinin adresi (paylaşım bağlantısı ve QR kod için)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000

# Demo girişi (isteğe bağlı). Şifre YALNIZCA sunucuda okunur, tarayıcıya gitmez.
# Hesabı randevu-web deposundaki scripts/create-demo-users.mjs oluşturur.
NEXT_PUBLIC_DEMO_LOGIN=
DEMO_OWNER_EMAIL=demo-isletme@randevu.test
DEMO_OWNER_PASSWORD=

# Uçtan uca testler (isteğe bağlı)
E2E_EMAIL=
E2E_PASSWORD=
